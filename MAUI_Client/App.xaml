<?xml version = "1.0" encoding = "UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:CrossCert"
             xmlns:converters="clr-namespace:CrossCert.ValueConverters"
             x:Class="CrossCert.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <!-- Register Value Converters -->
            <converters:CertStatusToTextConverter x:Key="CertStatusToTextConverter" />
            <converters:CertStatusToColorConverter x:Key="CertStatusToColorConverter" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
