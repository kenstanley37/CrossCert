<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CrossCert.Pages.AboutPage"
             Title="Program Information"
             Shell.NavBarIsVisible="True"
             BackgroundColor="{StaticResource AppBackground}">
    <ScrollView>
        <VerticalStackLayout 
            Padding="20"
            Spacing="15"
            MaximumWidthRequest="600"
            HorizontalOptions="CenterAndExpand">

            <Label 
                Text="CrossCert Manager"
                FontSize="Title"
                FontAttributes="Bold"
                TextColor="{StaticResource Primary}"
                HorizontalOptions="Center"
                Margin="0, 10, 0, 10"/>

            <Label 
                Text="Certificate Automation Tool"
                FontSize="Subtitle"
                TextColor="{StaticResource Gray400}"
                HorizontalOptions="Center"
                Margin="0, 0, 0, 20"/>

            <Frame BackgroundColor="{StaticResource InputBackground}" CornerRadius="8" Padding="15">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Version" FontAttributes="Bold" TextColor="{StaticResource LightText}"/>
                    <Label Text="1.0.0-beta" TextColor="{StaticResource Gray400}"/>
                </VerticalStackLayout>
            </Frame>

            <Frame BackgroundColor="{StaticResource InputBackground}" CornerRadius="8" Padding="15">
                <VerticalStackLayout Spacing="10">
                    <Label Text="License" FontAttributes="Bold" TextColor="{StaticResource LightText}"/>
                    <Label Text="MIT License - Copyright © 2024" TextColor="{StaticResource Gray400}"/>
                </VerticalStackLayout>
            </Frame>

            <Frame BackgroundColor="{StaticResource InputBackground}" CornerRadius="8" Padding="15">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Technologies Used" FontAttributes="Bold" TextColor="{StaticResource LightText}"/>
                    <Label Text=".NET MAUI, Entity Framework Core (SQLite), Certes" TextColor="{StaticResource Gray400}"/>
                </VerticalStackLayout>
            </Frame>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
