<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CrossCert.Pages.SettingsPage"
             Title="Application Settings"
             Shell.NavBarIsVisible="True"
             BackgroundColor="{StaticResource AppBackground}">
    <ScrollView>
        <VerticalStackLayout 
            Padding="20"
            Spacing="15"
            MaximumWidthRequest="600"
            HorizontalOptions="CenterAndExpand">

            <Label 
                Text="Application Settings"
                FontSize="Title"
                FontAttributes="Bold"
                TextColor="{StaticResource Primary}"
                HorizontalOptions="Center"
                Margin="0, 10, 0, 20"/>

            <Frame BackgroundColor="{StaticResource InputBackground}" CornerRadius="8" Padding="15">
                <VerticalStackLayout Spacing="10">
                    <Label Text="General" FontAttributes="Bold" TextColor="{StaticResource LightText}" FontSize="Subtitle"/>
                    <Label Text="Language: English" TextColor="{StaticResource Gray400}"/>
                    <Label Text="Theme: Follow System (Light/Dark)" TextColor="{StaticResource Gray400}"/>
                </VerticalStackLayout>
            </Frame>

            <Frame BackgroundColor="{StaticResource InputBackground}" CornerRadius="8" Padding="15">
                <VerticalStackLayout Spacing="10">
                    <Label Text="ACME Configuration" FontAttributes="Bold" TextColor="{StaticResource LightText}" FontSize="Subtitle"/>
                    <Label Text="ACME Server URL" TextColor="{StaticResource Gray400}"/>
                    <Entry Placeholder="Enter default ACME URL..." PlaceholderColor="{StaticResource Gray500}" TextColor="{StaticResource White}"/>
                </VerticalStackLayout>
            </Frame>

            <Button Text="Save Settings" HorizontalOptions="Fill" BackgroundColor="{StaticResource Magenta}" TextColor="{StaticResource White}" CornerRadius="8" HeightRequest="44" Margin="0, 20, 0, 0"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
