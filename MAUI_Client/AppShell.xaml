<Shell
x:Class="CrossCert.AppShell"
xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
xmlns:local="clr-namespace:CrossCert"
Shell.FlyoutBehavior="Disabled"
Title="CrossCert - Certificate Manager"
BackgroundColor="#003D73">
    <!-- Deep Blue/Navy Toolbar background -->

    <!-- Define the Styles for the Navigation Bar -->
    <Shell.Resources>
        <ResourceDictionary>
            <Style x:Key="BaseStyle" TargetType="Element">
                <Setter Property="Shell.BackgroundColor" Value="#003D73" />
                <Setter Property="Shell.ForegroundColor" Value="White" />
                <Setter Property="Shell.TitleColor" Value="White" />
                <Setter Property="Shell.UnselectedColor" Value="#B0C4DE" />
            </Style>
            <Style BasedOn="{StaticResource BaseStyle}" TargetType="ShellItem" />
        </ResourceDictionary>
    </Shell.Resources>

    <!--
    Define the main content of the application.
    The content defined here will appear inside the Shell structure.
-->
    <ShellContent
    Title="Domain Dashboard"
    ContentTemplate="{DataTemplate local:MainPage}"
    Route="MainPage" />

    <!--
    TODO: Add other sections here (e.g., Settings, Logs) as ShellContent items
    to create new navigation entries.
-->

    <!-- You can add a custom TitleView for a modern, branded look -->
    <Shell.TitleView>
        <StackLayout Orientation="Horizontal" Padding="10,0" VerticalOptions="Center">
            <Label 
            Text="CrossCert Manager" 
            TextColor="White" 
            FontSize="22" 
            FontAttributes="Bold"
            VerticalOptions="Center" />
        </StackLayout>
    </Shell.TitleView>

    <!-- Define Toolbar Items (Buttons on the right side of the toolbar) -->
    <Shell.ToolbarItems>
        <!-- The Add Domain ToolbarItem has been removed as functionality is consolidated on MainPage. -->

        <ToolbarItem 
        Text="Settings" 
        IconImageSource="settings_icon.png" 
        Clicked="OnSettingsClicked" 
        Order="Primary" />

        <ToolbarItem 
        Text="About" 
        IconImageSource="info_icon.png" 
        Clicked="OnAboutClicked" 
        Order="Secondary" />

    </Shell.ToolbarItems>

</Shell>