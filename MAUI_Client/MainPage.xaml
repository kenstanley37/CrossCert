<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:CrossCert.ViewModels"
             xmlns:models="clr-namespace:CrossCert.Models"
             x:Class="CrossCert.MainPage"
             x:DataType="viewmodels:MainPageViewModel"
             Title="Domain Dashboard"
             BackgroundColor="{StaticResource AppBackground}">

    <!-- The BindingContext is set in MainPage.xaml.cs via Dependency Injection -->

    <Grid RowDefinitions="Auto, *" ColumnDefinitions="*">

        <!-- Header Section -->
        <VerticalStackLayout Grid.Row="0" Margin="15, 20, 15, 10">
            <Label 
                Text="Managed Certificates" 
                FontSize="Large" 
                FontAttributes="Bold"
                TextColor="{StaticResource PrimaryDark}" />
            <Label 
                Text="Overview of all registered domains and their certificate status." 
                FontSize="Small" 
                TextColor="{StaticResource Gray500}"
                Margin="0, 0, 0, 10"/>
        </VerticalStackLayout>

        <!-- Domain List CollectionView -->
        <CollectionView 
            Grid.Row="1"
            ItemsSource="{Binding Domains}"
            SelectionMode="None"
            Margin="15, 0, 15, 15">

            <!-- FIX: Replaced problematic ItemWidth/ItemHeight properties with the correct Span property -->
            <CollectionView.ItemsLayout>
                <GridItemsLayout 
                    Orientation="Vertical" 
                    Span="1" 
                    VerticalItemSpacing="12"
                    HorizontalItemSpacing="12" />
            </CollectionView.ItemsLayout>

            <!-- DataTemplate for the Domain Card -->
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Domain">
                    <Frame 
                        Padding="15" 
                        CornerRadius="8" 
                        HasShadow="True" 
                        BackgroundColor="{StaticResource White}"
                        MinimumHeightRequest="120">

                        <!-- ADDED: TapGestureRecognizer to make the whole card clickable -->
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer 
                                Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:MainPageViewModel}}, Path=ViewDetailsCommand}"
                                CommandParameter="{Binding .}"
                                NumberOfTapsRequired="1" />
                        </Frame.GestureRecognizers>

                        <VerticalStackLayout Spacing="5">

                            <!-- Domain Name & Status Badge -->
                            <Grid ColumnDefinitions="*, Auto">
                                <Label 
                                    Grid.Column="0"
                                    Text="{Binding Name}" 
                                    FontSize="Subtitle" 
                                    FontAttributes="Bold" 
                                    TextColor="{StaticResource PrimaryDark}" />

                                <!-- Placeholder for Status (Example: Active vs. Expired) -->
                                <Frame 
                                    Grid.Column="1"
                                    Padding="5, 2" 
                                    CornerRadius="4" 
                                    BackgroundColor="{StaticResource Green200}"
                                    HorizontalOptions="End"
                                    VerticalOptions="Center">
                                    <Label 
                                        Text="Active" 
                                        FontSize="Caption" 
                                        TextColor="{StaticResource Green700}" />
                                </Frame>
                            </Grid>

                            <Label 
                                Text="{Binding SubjectAlternativeNames, StringFormat='SANs: {0}'}" 
                                FontSize="Caption" 
                                TextColor="{StaticResource Gray600}" />

                            <!-- Renewal Information -->
                            <StackLayout Orientation="Horizontal" Spacing="4" Margin="0, 5, 0, 0">
                                <Label 
                                    Text="Next Renewal:" 
                                    FontSize="Caption" 
                                    FontAttributes="Bold"
                                    TextColor="{StaticResource Gray700}" />
                                <Label 
                                    Text="{Binding NextRenewalAttempt, StringFormat='{0:MMM dd, yyyy}'}" 
                                    FontSize="Caption" 
                                    TextColor="{StaticResource Primary}" />
                            </StackLayout>

                            <!-- REMOVED: Placeholder Button - the Frame is now the clickable element -->
                            <!-- <Button 
                                Text="View Details" 
                                Style="{StaticResource TextButton}"
                                HorizontalOptions="End" 
                                Margin="0, 5, 0, 0"/> -->

                        </VerticalStackLayout>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
