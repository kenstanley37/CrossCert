<?xml version="1.0" encoding="UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:CrossCert"
             xmlns:converters="clr-namespace:CrossCert.ValueConverters"
             x:Class="CrossCert.App">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />

                <!-- NEW: High Contrast Theme -->
                <ResourceDictionary>
                    <!-- Color Palette -->
                    <Color x:Key="PrimaryBackgroundColor">#1A1A1A</Color>
                    <Color x:Key="SectionHeaderColor">#007ACC</Color>
                    <Color x:Key="ButtonColor">#2196F3</Color>
                    <Color x:Key="ButtonTextColor">#FFFFFF</Color>
                    <Color x:Key="BorderColor">#CCCCCC</Color>
                    <Color x:Key="ErrorColor">#FF5252</Color>
                    <Color x:Key="SuccessColor">#4CAF50</Color>

                    <!-- Button Style -->
                    <Style TargetType="Button">
                        <Setter Property="BackgroundColor" Value="{StaticResource ButtonColor}" />
                        <Setter Property="TextColor" Value="{StaticResource ButtonTextColor}" />
                        <Setter Property="CornerRadius" Value="6" />
                        <Setter Property="FontAttributes" Value="Bold" />
                        <Setter Property="Padding" Value="10,6" />
                    </Style>

                    <!-- Section Header Label Style -->
                    <Style x:Key="SectionHeaderStyle" TargetType="Label">
                        <Setter Property="TextColor" Value="{StaticResource SectionHeaderColor}" />
                        <Setter Property="FontAttributes" Value="Bold" />
                        <Setter Property="FontSize" Value="18" />
                    </Style>

                    <!-- Border Style -->
                    <Style TargetType="Border">
                        <Setter Property="Stroke" Value="{StaticResource BorderColor}" />
                        <Setter Property="StrokeThickness" Value="1" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="Padding" Value="10" />
                        <Setter Property="Margin" Value="5" />
                    </Style>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>

            <!-- Register Value Converters -->
            <converters:CertStatusToTextConverter x:Key="CertStatusToTextConverter" />
            <converters:CertStatusToColorConverter x:Key="CertStatusToColorConverter" />
        </ResourceDictionary>
    </Application.Resources>
</Application>