<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:CrossCert.ViewModels"
             xmlns:toolkit="clr-namespace:CommunityToolkit.Maui.Views;assembly=CommunityToolkit.Maui"
             x:Class="CrossCert.Views.MainPage"
             x:DataType="viewmodels:MainPageViewModel"
             Title="CrossCert">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">

            <!-- 🧾 Managed Domains -->
            <toolkit:Expander>
                <toolkit:Expander.Header>
                    <Label Text="🧾 Managed Domains" FontAttributes="Bold" FontSize="18" />
                </toolkit:Expander.Header>
                <VerticalStackLayout Spacing="10">
                    <CollectionView ItemsSource="{Binding Domains}">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border Stroke="Gray" StrokeThickness="1" Padding="10" Margin="5" Background="Transparent">
                                    <VerticalStackLayout>
                                        <Label Text="{Binding DomainName}" FontAttributes="Bold" />
                                        <Label Text="{Binding StatusText}" TextColor="{Binding StatusColor}" />
                                        <HorizontalStackLayout Spacing="10">
                                            <Button Text="Edit"
                                                    IsEnabled="False"
                                                    WidthRequest="100"
                                                    HorizontalOptions="Start" />
                                            <Button Text="Delete"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:MainPageViewModel}}, Path=DeleteDomainCommand}"
                                                    CommandParameter="{Binding .}"
                                                    WidthRequest="100"
                                                    HorizontalOptions="Start" />
                                        </HorizontalStackLayout>
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                    <Button Text="Add Domain"
                            Command="{Binding AddDomainCommand}"
                            WidthRequest="150"
                            HorizontalOptions="Start" />
                </VerticalStackLayout>
            </toolkit:Expander>

            <!-- 📜 Certificate Actions -->
            <toolkit:Expander>
                <toolkit:Expander.Header>
                    <Label Text="📜 Certificate Actions" FontAttributes="Bold" FontSize="18" />
                </toolkit:Expander.Header>
                <HorizontalStackLayout Spacing="10" HorizontalOptions="Center">
                    <Button Text="Generate"
                            IsEnabled="False"
                            WidthRequest="120" />
                    <Button Text="Export"
                            IsEnabled="False"
                            WidthRequest="120" />
                    <Button Text="Install"
                            IsEnabled="False"
                            WidthRequest="120" />
                </HorizontalStackLayout>
            </toolkit:Expander>

            <!-- 🔄 Renewal Status -->
            <toolkit:Expander>
                <toolkit:Expander.Header>
                    <Label Text="🔄 Renewal Status" FontAttributes="Bold" FontSize="18" />
                </toolkit:Expander.Header>
                <VerticalStackLayout Spacing="10">
                    <CollectionView ItemsSource="{Binding RenewalLogs}">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border Stroke="LightGray" StrokeThickness="1" Padding="10" Margin="5" Background="Transparent">
                                    <VerticalStackLayout>
                                        <Label Text="{Binding Domain.DomainName}" FontAttributes="Bold" />
                                        <Label Text="{Binding Timestamp}" FontSize="12" />
                                        <Label Text="{Binding Result}" TextColor="Green" FontSize="12" />
                                        <Label Text="{Binding ErrorMessage}" TextColor="Red" FontSize="12" />
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                    <Button Text="Run Manual Renewal"
                            Command="{Binding ManualRenewCommand}"
                            WidthRequest="180"
                            HorizontalOptions="Start" />
                </VerticalStackLayout>
            </toolkit:Expander>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>